# Weights and model source live on the box / on HuggingFace, never here.
*.safetensors
*.bin
*.pt
vendor/

# Test photographs are third-party stock (one carries a Dreamstime watermark)
# and the renders derive from them.
*.png
*.jpg
*.jpeg
*.jfif
# ...except the README demo assets. These are renders over third-party stock
# photos (panel_006 carries a TopTropicals watermark) -- fine while this repo is
# private, worth re-sourcing before making it public.
!assets/*

# The prebuilt flash-attn wheel is 55 MB — too big to version, and only valid
# for one exact stack. wheels/README.md documents it; RUNBOOK.md has the recipe.
wheels/*.whl

# Build artifacts
build/
dist/
*.egg-info/

# Scratch benchmark output, but keep results/ — those JSONs are the raw data
# behind the measured numbers and are a few KB each.
*.json
!results/*.json

__pycache__/
*.pyc

# local test inputs, not part of the repo
inbox/

# The measurement archive: the harness that produced every number quoted below,
# the working record, and the upstream-report drafts. Evidence tooling, not
# tooling for using the fix. Nothing in scripts/ imports it -- the helpers it did
# own were lifted into scripts/la_common.py.
#
# It is also a git repo of its own, with no remote. That is deliberate: ignored
# here means it is never pushed, and nested means `git clean -xdf` will not
# recurse into it. Only `git clean -ffdx` can destroy it.
archive/
