+def _cache_to_pairs(cache):
+    """Cache -> ((k, v), ...) per layer, i.e. the old legacy-tuple view.
+
+    transformers 5.x removed Cache.to_legacy_cache()/from_legacy_cache() along
+    with the tuple cache format. engine_hybrid.py is written entirely against
+    that view -- it packs rows into a batch, right-aligns and pads each row's
+    KV, then slices the result back apart per row -- so the conversion happens
+    here, at the one boundary, rather than by rewriting the batch engine.
+
+    5.x keeps the tensors on cache.layers[i].keys/.values.
+    """
+    if hasattr(cache, "to_legacy_cache"):
+        return cache.to_legacy_cache()
+    return tuple((layer.keys, layer.values) for layer in cache.layers)
+
+
+def _cache_from_pairs(dynamic_cache_cls, pairs):
+    """The inverse. update() on a fresh DynamicCache initialises each layer."""
+    if hasattr(dynamic_cache_cls, "from_legacy_cache"):
+        return dynamic_cache_cls.from_legacy_cache(pairs)
+    cache = dynamic_cache_cls()
+    for layer_idx, (k, v) in enumerate(pairs):
+        cache.update(k, v, layer_idx)
+    return cache
+
