+def _unpack_stock_rows_batched(out_kv, old_lens, uncached_lens, kmax, umax, dev):
+    """Batched replacement for the per-row _unpack_stock_after_forward loop.
+
+    Stock calls _unpack_stock_after_forward once per ROW, and each call walks
+    all 36 layers doing two slices and a torch.cat. At 48 rows that is 3,456
+    cat launches and ~6,900 slice views per forward -- 8-9% of wall. It is
+    dispatch-bound, not bandwidth-bound: shrinking head_dim 128->1 (1/128 the
+    bytes, identical op count) barely moves it.
+
+    Here the row-dependent part -- which source positions each row keeps -- is
+    built ONCE as an index tensor and reused for every layer, so per-layer work
+    is a single gather instead of B cats.
+
+    MEMORY: this holds [B, H, kept_max, D] per layer where the stock loop held
+    sum(kept). With ragged rows that is MORE memory, not less. It is a latency
+    change and NOT a fix for the 4.7x KV over-hold, which lives in
+    _pack_stock_kv_rows.
+    """
+    n = len(old_lens)
+    kept = [old_lens[i] + uncached_lens[i] for i in range(n)]
+    kept_max = max(kept) if kept else 0
+    if kept_max == 0:
+        return [tuple((k[i : i + 1, :, :0, :], v[i : i + 1, :, :0, :])
+                      for k, v in out_kv) for i in range(n)]
+
+    idx_np = np.zeros((n, kept_max), dtype=np.int64)
+    for i in range(n):
+        parts = []
+        if old_lens[i]:
+            parts.append(np.arange(kmax - old_lens[i], kmax, dtype=np.int64))
+        if uncached_lens[i]:
+            u0 = kmax + (umax - uncached_lens[i])
+            parts.append(np.arange(u0, kmax + umax, dtype=np.int64))
+        if parts:
+            row = np.concatenate(parts)
+            idx_np[i, : len(row)] = row
+    idx = torch.from_numpy(idx_np).to(dev, non_blocking=True)
+
+    per_row = [[] for _ in range(n)]
+    for k, v in out_kv:
+        ii = idx.view(n, 1, kept_max, 1).expand(-1, k.shape[1], -1, k.shape[3])
+        gk = k.gather(2, ii)
+        gv = v.gather(2, ii)
+        for i in range(n):
+            per_row[i].append((gk[i : i + 1, :, : kept[i], :],
+                               gv[i : i + 1, :, : kept[i], :]))
+    return [tuple(r) for r in per_row]
+
+
